# ── Tracking Pixels ────────────────────────────────────────────────────────
# Adicionar como Secrets no GitHub: Settings → Secrets → Actions → New secret

# Meta Pixel ID (15 dígitos) — events_manager na Meta Business Suite
VITE_META_PIXEL_ID=

# Google Analytics 4 Measurement ID — analytics.google.com
VITE_GA4_ID=

# Google Ads Conversion ID — formato: AW-XXXXXXXXX (sem a barra e o label)
VITE_GADS_ID=

# Google Ads Conversion Label — a parte após a barra: AW-XXXXXXXXX/LABEL_AQUI
VITE_GADS_LABEL=

# Microsoft Clarity Project ID — clarity.microsoft.com
VITE_CLARITY_ID=
